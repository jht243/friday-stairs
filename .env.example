OPENAI_API_KEY=sk-...
# Optional: enables open-web recipe search via SerpAPI
SERPAPI_KEY=

# Resend (partnership inquiry email -> fridaystairs@gmail.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=jonathan@layer3labs.io

# Supabase — generated-content memory / dedup (table: generated_content)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...          # service key — server-side reads/writes
# Postgres connection URI (Project Settings -> Database -> Connection string -> URI).
# Used ONLY by `npm run migrate` to create tables. Contains your DB password.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Partner-page stats micro-CMS (editor at /dashboard) ──────────────────────
# The four Partner-page stats are stored in Supabase (table:
# friday_stairs_partner_stats) and edited via the /dashboard login. The server
# talks to Supabase over its REST API.
#   URL/anon key: Supabase -> Project Settings -> API.
#   service_role key: same page, "service_role" secret. NEVER exposed to the
#   browser — used only for server-side saves.
PARTNER_STATS_SUPABASE_URL=https://<project-ref>.supabase.co
PARTNER_STATS_SUPABASE_ANON_KEY=eyJ... (anon / publishable key — used for reads)
PARTNER_STATS_SUPABASE_SERVICE_KEY=eyJ... (service_role secret — used for saves)

# Password-only login for the /dashboard stats editor.
PARTNER_ADMIN_PASSWORD=choose-a-strong-shared-password
